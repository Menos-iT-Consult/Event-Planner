generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  WEDDING
  VOTING
  GENERAL
}

enum UserRole {
  ADMIN
  EVENT_MANAGER
  CHECK_IN_STAFF
}

enum RsvpStatus {
  ATTENDING
  DECLINED
  PENDING
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  passwordHash String
  role         UserRole         @default(EVENT_MANAGER)
  memberships  EventMembership[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Event {
  id           String           @id @default(uuid())
  slug         String           @unique
  title        String
  type         EventType
  startDate    DateTime         @db.Date
  endDate      DateTime         @db.Date
  durationDays Int
  dailyRate    Decimal          @db.Decimal(12, 2)
  totalCost    Decimal          @db.Decimal(12, 2)
  voteUnitPrice Decimal?        @db.Decimal(12, 2)
  currency     String           @default("GHS")
  location     String
  description  String?
  memberships  EventMembership[]
  guests       Guest[]
  categories   Category[]
  budgets      BudgetItem[]
  vendors      Vendor[]
  registry     RegistryItem[]
  ticketTiers  TicketTier[]
  sessions     EventSession[]
  votes        Vote[]
  votePurchases VotePurchase[]
  orders       TicketOrder[]
  smsLogs      SmsLog[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model EventMembership {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  role      UserRole
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId, role])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Decimal  @db.Decimal(12, 2)
  description String?
  updatedAt   DateTime @updatedAt
}

model Guest {
  id            String     @id @default(uuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  status        RsvpStatus @default(PENDING)
  plusOnes      Int        @default(0)
  plusOnesAllowed Int      @default(0)
  dietary       String?
  rsvpTokenHash String?    @unique
  passTokenHash String?    @unique
  qrObjectKey   String?
  checkedInAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([eventId, status])
  @@index([eventId, phone])
}

model Category {
  id         String      @id @default(uuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  candidates Candidate[]
  votes      Vote[]
  votePurchases VotePurchase[]
  createdAt  DateTime    @default(now())

  @@unique([eventId, name])
}

model Candidate {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  photoKey    String?
  votesCount  Int      @default(0)
  votes       Vote[]
  votePurchases VotePurchase[]
  createdAt   DateTime @default(now())
}

model Vote {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voterHash   String
  paid        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([eventId, categoryId, voterHash])
  @@index([candidateId, createdAt])
}

model VotePurchase {
  id               String      @id @default(uuid())
  eventId          String
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voterHash        String
  voterEmail       String
  voterPhone       String
  quantity         Int
  amount           Decimal     @db.Decimal(12, 2)
  currency         String      @default("GHS")
  status           OrderStatus @default(PENDING)
  paymentReference String      @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([candidateId, status])
}

model BudgetItem {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category      String
  estimatedCost Decimal  @db.Decimal(12, 2)
  actualCost    Decimal? @db.Decimal(12, 2)
  paid          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Vendor {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  service     String
  phone       String?
  email       String?
  agreedCost  Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
}

model RegistryItem {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  price       Decimal? @db.Decimal(12, 2)
  claimed     Boolean  @default(false)
  claimedBy   String?
  createdAt   DateTime @default(now())

  @@index([eventId, claimed])
}

model TicketTier {
  id          String        @id @default(uuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  quantity    Int
  sold        Int           @default(0)
  orders      TicketOrder[]

  @@unique([eventId, name])
}

model EventSession {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  speaker     String?

  @@index([eventId, startsAt])
}

model TicketOrder {
  id               String      @id @default(uuid())
  eventId          String
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTierId     String
  ticketTier       TicketTier  @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)
  purchaserName    String
  purchaserEmail   String
  purchaserPhone   String
  quantity         Int
  amount           Decimal     @db.Decimal(12, 2)
  currency         String      @default("GHS")
  status           OrderStatus @default(PENDING)
  paymentReference String?     @unique
  accessTokenHash  String?     @unique
  expiresAt        DateTime
  tickets          Ticket[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([eventId, status])
  @@index([status, expiresAt])
}

model Ticket {
  id            String      @id @default(uuid())
  orderId       String
  order         TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  passTokenHash String      @unique
  qrObjectKey   String?
  checkedInAt   DateTime?
  createdAt     DateTime    @default(now())
}

model SmsLog {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient   String
  message     String
  status      SmsStatus @default(QUEUED)
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventId, createdAt])
}
